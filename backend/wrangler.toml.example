name = "money-tracker-backend"
main = "src/index.ts"
compatibility_date = "2026-09-22"
compatibility_flags = [ "nodejs_compat" ]

[vars]
CORS_ORIGIN = "http://localhost:5173"

[[d1_databases]]
binding = "DB"
database_name = "money_tracker"
database_id = "local"
migrations_dir = "drizzle"
migrations_pattern = "drizzle/*/migration.sql"

# Serve the built frontend from the same origin as the API, so the auth
# cookie is first-party (works on Safari/iOS) and no CORS is needed.
[assets]
directory = "../frontend/dist"
not_found_handling = "single-page-application"
# API requests hit the Worker; everything else is served as static assets.
run_worker_first = ["/api/*", "/health"]
