    "@money-tracker/shared": "workspace:*",
    "@types/node": "^26.6.3",
    "better-auth": "^1.7.6",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@cloudflare/workers-types": "^5.20260921.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.0"
