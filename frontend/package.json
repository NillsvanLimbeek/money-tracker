{
  "name": "frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --project unit",
    "test:a11y": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "generate": "vite build --outDir node_modules/.tmp/generate --emptyOutDir",
    "type-check": "pnpm generate && vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@money-tracker/shared": "workspace:*",
    "@nuxt/ui": "^4.11.1",
    "@tanstack/vue-query": "^5.102.8",
    "@vueuse/core": "^14.4.0",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.12",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
