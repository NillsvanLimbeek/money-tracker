{
  "name": "money-tracker",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "concurrently -n FE,BE -c green,yellow \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm -C frontend dev",
    "dev:backend": "pnpm -C backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "type-check": "pnpm -r type-check",
    "test:unit": "pnpm -C frontend test:unit",
    "test:a11y": "pnpm -C frontend test:a11y",
    "test:e2e": "pnpm -C frontend test:e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
